pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    IMAGE_NAME = 'devsecops-demo'
    IMAGE_TAG = "${BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Secret and Vulnerability Scan') {
      steps {
        sh '''
          set -e
          /usr/local/bin/trivy fs --scanners vuln,misconfig,secret --severity HIGH,CRITICAL --exit-code 1 automated-security-compliance-cicd
        '''
      }
    }

    stage('IaC Security Scan') {
      steps {
        sh 'checkov -d kubernetes --framework kubernetes'
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh 'sonar-scanner'
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ./app'
      }
    }

    stage('Container Image Scan') {
      steps {
        sh 'trivy image --severity HIGH,CRITICAL --exit-code 1 ${IMAGE_NAME}:${IMAGE_TAG}'
      }
    }

    stage('Approval for Release') {
      when { branch 'main' }
      steps {
        input message: 'Security scans completed. Approve this demo image for release?'
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'security/*,sonar-project.properties,kubernetes/*.yaml', allowEmptyArchive: true
    }
  }
}

